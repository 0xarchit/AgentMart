# ---------- Supabase (shared across market, user, web) ----------
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=
SUPABASE_JWKS_URL=

# ---------- Razorpay (test mode only) ----------
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
RAZORPAY_ACCOUNT_NUMBER=

# ---------- Telegram ----------
TELEGRAM_BOT_TOKEN=
TELEGRAM_OFFSET_FILE=./data/telegram-offset.json
TELEGRAM_BOT_USERNAME=
# Set this to the buyer's public https url and the bot switches from polling to a
# webhook: the buyer registers it at startup and Telegram posts each update to
# <url>/telegram/webhook. Empty means polling, which is what a local run does.
TELEGRAM_WEBHOOK_URL=
# Required alongside a webhook url, and checked on every delivery. Without it anyone
# who found the url could forge a message from a linked person.
TELEGRAM_WEBHOOK_SECRET_TOKEN=
# Forces polling even when a webhook url is set, for running locally against a copy
# of the deployed environment.
TELEGRAM_USE_POLLING=

# ---------- OpenAI-compatible reasoning endpoint (buyer and merchant agents) ----------
OPENAI_API_KEY=
OPENAI_BASE_URL=
ADK_MODEL_NAME=
ADK_MODEL_TEMPERATURE=

# ---------- Upstash Redis (shared across market and user; market will not start without it) ----------
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# ---------- market binary (merchant MCP + A2A server) ----------
MARKET_HTTP_PORT=
MARKET_MCP_PORT=
MARKET_A2A_PORT=
MARKET_ENV=
MARKET_LOG_LEVEL=
MARKET_AGENT_CARD_URL=
MARKET_SHARED_TOKEN=

# ---------- user binary (buyer agent + telegram bot + gate) ----------
USER_HTTP_PORT=
USER_ENV=
USER_LOG_LEVEL=
USER_MARKET_MCP_ENDPOINT=
USER_MARKET_A2A_ENDPOINT=
# Read by no code. The standing limit for a new account is set in the schema.
DEFAULT_SPEND_LIMIT_PAISE=
REFUND_WINDOW_MINUTES=

# ---------- web (Next.js dashboard) ----------
NEXT_PUBLIC_APP_URL=
NEXT_PUBLIC_RAZORPAY_KEY_ID=
NEXTAUTH_SECRET=
WALLET_TOPUP_MIN_PAISE=
WALLET_TOPUP_MAX_PAISE=

# ---------- Shared/general ----------
NODE_ENV=
GO_ENV=
TZ=

# Buyer agent A2A service (quote-only; never debits a wallet)
USER_AGENT_ADDR=:8082
USER_AGENT_CARD_URL=http://localhost:8082/a2a/
USER_AGENT_TOKEN=
