# AgentMart .env.example
# Copy to .env in each component root (market/.env, user/.env, web/.env.local) or keep one root .env and load per-component as needed.
# No real secrets committed. All Razorpay keys below must be test-mode keys (rzp_test_...).

# ---------- Supabase (shared across market, user, web) ----------
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_DB_PASSWORD=
SUPABASE_PROJECT_REF=

# ---------- Razorpay (test mode only) ----------
RAZORPAY_KEY_ID=rzp_test_
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
RAZORPAY_ACCOUNT_NUMBER=

# ---------- Telegram ----------
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=
TELEGRAM_WEBHOOK_URL=
TELEGRAM_WEBHOOK_SECRET_TOKEN=
TELEGRAM_USE_POLLING=true

# ---------- Reasoning/model provider (buyer and merchant agents) ----------
ADK_MODEL_PROVIDER=
ADK_MODEL_NAME=
ADK_MODEL_API_KEY=
ADK_MODEL_TEMPERATURE=0.2

# ---------- market binary (merchant MCP + A2A server) ----------
MARKET_HTTP_PORT=8081
MARKET_MCP_PORT=8082
MARKET_A2A_PORT=8083
MARKET_ENV=development
MARKET_LOG_LEVEL=info
MARKET_AGENT_CARD_URL=

# ---------- user binary (buyer agent + telegram bot + gate) ----------
USER_HTTP_PORT=8090
USER_ENV=development
USER_LOG_LEVEL=info
USER_MARKET_MCP_ENDPOINT=http://localhost:8082
USER_MARKET_A2A_ENDPOINT=http://localhost:8083
DEFAULT_SPEND_LIMIT_PAISE=250000
REFUND_WINDOW_MINUTES=60

# ---------- web (Next.js dashboard) ----------
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_RAZORPAY_KEY_ID=rzp_test_
NEXTAUTH_SECRET=
WALLET_TOPUP_MIN_PAISE=10000
WALLET_TOPUP_MAX_PAISE=1000000

# ---------- Shared/general ----------
NODE_ENV=development
GO_ENV=development
TZ=Asia/Kolkata
